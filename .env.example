# =====================================================================
# LearnMate AI - Supabase & Server Environment Variables
# =====================================================================

# 1. Supabase Project Configuration (From your Supabase Project Settings > API)
# The URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Publishable Key (safe to use in frontend with RLS enabled)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# 2. Server-side Secrets (DO NOT expose these in frontend code or git)
# OpenAI API Key for secure server-side AI Notes & AI Tutor generation
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Optional: Supabase Service Role Key (only for admin migration scripts or backend jobs)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Flask Server Port
PORT=3000
